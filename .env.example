# Copie para .env e preencha. Ou rode "npm run configurar", que faz isso sozinho.

# Assina os tokens. Obrigatório, mínimo 32 caracteres.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Sem os dois, não abre dentro do Discord.
# No portal: https://discord.com/developers/applications, aba OAuth2.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Opcional. Confere se a pessoa está mesmo na call, e traz nome, imagem e
# tamanho dos servidores no painel. O bot precisa estar no servidor.
# No mesmo portal, aba Bot, botão Reset Token.
DISCORD_BOT_TOKEN=

# Endereço público. Quem abre o túnel preenche sozinho.
PUBLIC_ORIGIN=http://localhost:3001

# Porta local.
PORT=3001

# "production" liga as travas de segurança.
NODE_ENV=development

# 1 = terminal resumido para uso normal; 0 = logs completos para desenvolvimento.
TERMINAL_LIMPO=1

# 1 verifica e aplica somente avanço seguro do origin/main em checkout Git limpo.
ATUALIZACAO_AUTOMATICA=1

# 1 mantém diagnóstico técnico local e sanitizado em .logs/.
DIAGNOSTICO_LOCAL=1

# Envio automático é opt-in. Vazio = nunca envia nada.
DIAGNOSTICO_UPLOAD_URL=
DIAGNOSTICO_UPLOAD_TOKEN=

# Túnel de endereço fixo. Preenchido por "npm run tunel:criar".
TUNEL_CONFIG=

# ID da sua conta, não o Client ID nem o do servidor.
# No Discord, não no portal: Configurações, Avançado, Modo desenvolvedor.
# Depois botão direito no seu nome, Copiar ID.
# Só esta conta abre /admin. Vazio = painel desligado.
DISCORD_ADMIN_ID=

# ID do servidor do Discord. Preenchido = só membros dele usam a atividade,
# e o site fora do Discord deixa de abrir lobby e convidados.
# Exige DISCORD_BOT_TOKEN com o bot dentro desse servidor.
# Botão direito no ícone do servidor, Copiar ID. Vários: separe por vírgula.
DISCORD_GUILD_ID=
